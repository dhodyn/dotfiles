[alias]
	diffdelta = !git diff "$@" | delta --side-by-side

[branch]
	autoSetupRebase = always

[color]
	ui = auto

[core]
	editor = vim
	excludesfile = ~/.config/git/ignore
	hooksPath = ~/.config/git/hooks

[diff]
	algorithm = histogram
	tool = vimdiff

[difftool]
	prompt = false

[fetch]
	prune = true

[init]
	defaultBranch = main

[merge]
	tool = vimdiff
	ff = only

[mergetool]
	prompt = false

[rebase]
	autosquash = true
	autoStash = true

[rerere]
	enabled = true

[pull]
	rebase = true
	ff = only

[push]
	autoSetupRemote = true
	default = simple

[user]
	name = Navneet Dhody
	email = navneet.dhody@gmail.com

[credential]
	helper = store

[credential "https://github.com"]
	helper = !gh auth git-credential
