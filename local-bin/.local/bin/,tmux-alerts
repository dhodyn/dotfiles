#!/usr/bin/env bash
set -euo pipefail

current_session=$(tmux display-message -p '#S')
alert_sessions=$(tmux list-sessions -F '#S #{session_alerts}' | while read session has_alerts; do
  [[ "${session}" != "${current_session}" ]] && [[ -n "${has_alerts}" ]] && echo "${session}!"
done | paste -sd ' ')
echo -n " ${alert_sessions} "
