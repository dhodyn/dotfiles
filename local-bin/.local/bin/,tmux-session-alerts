#!/usr/bin/env bash
set -euo pipefail

current_session=$(tmux display-message -p '#S')
alert_sessions=$(tmux list-sessions -F '#S #{session_alerts}' | while read -r session has_alerts; do
  if [[ "${session}" != "${current_session}" ]] && [[ -n "${has_alerts}" ]]; then
    echo "${session}!"
  fi
done | paste -sd ' ')
[[ -n "${alert_sessions}" ]] && echo -n " ${alert_sessions} " || true
